{
  "version": "1",
  "note": "示例清单：按需增删条目。source 为打包根(--root, 默认 $HOME)下相对路径；target 支持 ~ 展开到开发用户家目录；encrypted 产物存于本目录。示例条目需本地存在对应源文件后运行 encrypt.sh 生成密文。",
  "entries": [
    {
      "type": "dir",
      "source": ".ssh",
      "target": "~/.ssh",
      "mode": "0700",
      "encrypted": "ssh.tar.age",
      "note": "SSH 私钥与 known_hosts"
    },
    {
      "type": "file",
      "source": ".gitconfig",
      "target": "~/.gitconfig",
      "mode": "0600",
      "encrypted": "gitconfig.age",
      "note": "Git 身份与别名配置"
    },
    {
      "type": "file",
      "source": ".config/devbox/tokens.env",
      "target": "~/.config/devbox/tokens.env",
      "mode": "0600",
      "encrypted": "tokens.env.age",
      "note": "示例：令牌文件（本地创建后加密，明文不入库）"
    }
  ]
}
