# =============================================================================
# .env.example —— DevBox 集中配置模板（M15：所有配置项在此一处编辑）
# 用法：cp .env.example .env && vi .env ，然后 docker compose -p devbox up -d
# 说明：docker compose 自动加载同目录 .env；带注释 # 开头为默认值，按需去掉注释修改
# =============================================================================

# ---- 镜像与端口 ----
#DEVBOX_IMAGE=ghcr.io/zeek-zhao/devbox:latest   # 镜像（一般不用改；自建镜像时替换）
WEB_PORT=8080                                    # 网页入口（宿主端口）
SSH_PORT=2222                                    # SSH 入口（宿主端口）

# ---- 账号与密码 ----
HOST_UID=1000                                    # dev 用户 uid（对齐宿主当前用户：id -u）
HOST_GID=1000                                    # dev 用户 gid（id -g）
DEV_USER=dev                                     # 开发用户名
# 留空 = 启动时自动生成 24 位随机密码，登录凭证见容器内 /run/devbox/SERVICES.md
# （查询：docker exec devbox cat /run/devbox/SERVICES.md）
DEV_PASSWORD=
ROOT_PASSWORD=

# ---- 对外地址（DSH token 链接生成用）----
# 容器无法感知宿主对外地址，精确链接请配置（例：http://192.168.1.10:8080）
# 留空 = 自动探测容器 IP（宿主机局域网可达时可用；NAT/远程环境请显式配置）
PUBLIC_URL=

# ---- 功能开关 ----
ENABLE_DSH=1                                     # 1=启用 DSH（/dsh/）
ENABLE_MAGPIE=1                                  # 1=启用 Magpie（/magpie/，面板含 Agents/Sessions/Library）
ENABLE_TAILSCALE=0                               # 1=启用 Tailscale（首启需 key.txt 解密 auth key，见 README）

# ---- Tailscale ----
TS_HOSTNAME=devbox                               # 固定机器名（与认证绑定，勿随意更改）
#TS_AGE_KEY_FILE=/run/devbox/key.txt             # age 私钥挂载路径（默认 /run/devbox/key.txt）

# ---- Magpie ----
MAGPIE_WEB_KEY=devbox-magpie-key                 # 面板访问 key（公网部署务必改成 16+ 随机串）

# ---- 其他 ----
TZ=Asia/Shanghai
