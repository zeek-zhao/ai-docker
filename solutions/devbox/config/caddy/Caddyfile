# =============================================================================
# Caddyfile —— zeek-ai-devbox 单端口统一反代（PLAN §6.1）
# 文档编号：NT-001 · 版本：v1.0 · 2026-11-27 · 维护人：zeek.zhao
# 路由：/_auth 登录 → forward_auth 统一会话 → / 首页 / /term / /file-share / /dsh / /magpie
# 所有内部后端仅绑 127.0.0.1；WebSocket 透传（ttyd/DSH 依赖）
# =============================================================================
{
	admin off
}

:8080 {
	encode zstd gzip

	route {
		# 登录/登出页直连 auth-gate（免鉴权区；缺失会导致 /login 被 forward_auth 拦截成重定向循环）
		@auth_free path /login /logout
		handle @auth_free {
			reverse_proxy 127.0.0.1:9090
		}

		# 登录/登出（兼容别名，前缀剥离后 auth-gate 见 /login /logout）
		handle_path /_auth/* {
			reverse_proxy 127.0.0.1:9090
		}

		# Magpie 网关 OpenAI 兼容 API 直通（M8/D21：免网页登录反代 3425，认证交 magpie 自身；
		# 需置于 forward_auth 之前，否则 /v1/* 被会话鉴权 302 成登录页 HTML——外部客户端拿到页面而非 API 响应）
		handle /v1/* {
			reverse_proxy 127.0.0.1:3425 {
				header_up Host 127.0.0.1:3425
			}
		}

		# 统一登录态会话鉴权：未登录一律先跳登录页（PLAN §6.1）
		# 注意：禁止 copy_headers Cookie——auth-gate /verify 响应无 Cookie 头，该指令会把发往上游的
		# Cookie 头清空，导致 dsh/magpie 收不到自身会话 Cookie 而 401（D15 实证）；客户端 Cookie
		# 由 reverse_proxy 默认透传，无需显式配置。
		forward_auth 127.0.0.1:9090 {
			uri /verify
		}

		# /term → ttyd Web 终端（dev 用户会话）
		redir /term /term/ 308
	redir /file-share /file-share/ 308
	handle /term/* {
			reverse_proxy 127.0.0.1:7681
		}

		# /file-share → filebrowser（浏览/上传/删除 devbox 数据目录）
		handle /file-share/* {
			reverse_proxy 127.0.0.1:8081
		}

		# /dsh → DSH Web（dsh web，镜像内置；handle_path 剥前缀——dsh 按 --public-url 以前缀形态发布）
		# fence 链：dsh 校验 X-Forwarded-Host（客户端入口 authority）须 ∈ --trusted-host（entrypoint 从 DSH_PUBLIC_URL 解析注入）
		handle_path /dsh/* {
			@dsh_disabled not file /run/devbox/dsh/enabled
			respond @dsh_disabled "DSH 未启用（compose: ENABLE_DSH=1）" 503
			reverse_proxy 127.0.0.1:3081 {
				header_up Host 127.0.0.1:3081
			}
		}

		# /magpie → Magpie 面板（镜像内置；网关 API 3425 不对外；handle_path 剥前缀——magpie 按 MAGPIE_WEB_URL 前缀形态发布）
		handle_path /magpie/* {
			@magpie_disabled not file /run/devbox/magpie/enabled
			respond @magpie_disabled "Magpie 未启用（compose: ENABLE_MAGPIE=1）" 503
			reverse_proxy 127.0.0.1:3430 {
				header_up Host 127.0.0.1:3430
			}
		}

		# magpie 面板 XHR 以绝对路径 /api/* 发出（前端限制，不带 /magpie 前缀），
		# 按 Referer 归属 magpie，与 homepage 自身 /api/*（Referer 为首页路径）区分，避免误抢
		@magpie_api {
			path /api/*
			header_regexp Referer "/magpie(/|$)"
		}
		handle @magpie_api {
			reverse_proxy 127.0.0.1:3430 {
				header_up Host 127.0.0.1:3430
			}
		}

		# / → HomePage 导航首页（无匹配器兜底，必须置于 route 末位，否则吞掉上述全部路由）
		# Next.js 16 校验 Host 白名单，反代需改写 Host 为 upstream 本址
		handle {
			reverse_proxy 127.0.0.1:3000 {
				header_up Host 127.0.0.1:3000
			}
		}

		respond 404
	}
}
